# These are environment variables. Source a trusted local .env yourself; run.sh does not load it.
FSP_DEMO=1
FSP_COOKIE_SECURE=0
# FSP_DATABASE=/absolute/path/fsp.sqlite3
# For real email delivery, use a private local environment; never commit credentials.
# FSP_SMTP_HOST=smtp.example.org
# FSP_SMTP_PORT=587
# FSP_SMTP_FROM=noreply@example.org
# FSP_SMTP_USER=
# FSP_SMTP_PASSWORD=
# Public operator details only. Leave unset until real, verified company details are available.
# These five values are intentionally exposed through /api/legal/config.
# FSP_OPERATOR_NAME=
# FSP_OPERATOR_INN=
# FSP_OPERATOR_OGRN=
# FSP_OPERATOR_ADDRESS=
# FSP_OPERATOR_EMAIL=
